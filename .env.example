# Neon Postgres — provisioned via Vercel Marketplace (vercel integration add neon)
DATABASE_URL=

# Clerk — provisioned via Vercel Marketplace (vercel integration add clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# App URL — used for OAuth discovery (MCP remote auth)
NEXT_PUBLIC_APP_URL=https://chaospatch.adhdesigns.dev

# Cloudflare R2 — image attachment storage (S3-compatible API)
# Create a bucket + an R2 API token (Object Read & Write) in the Cloudflare
# dashboard, and add a CORS rule allowing PUT from your app's origin(s).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
